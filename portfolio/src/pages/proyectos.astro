---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, projectCategories } from "../data/site";
---

<Layout title="Proyectos" description="Proyectos personales, freelance y de videojuegos de Alejandro Zumbado.">
  <section class="mx-auto max-w-5xl px-6 py-14">
    <div data-reveal>
      <h1 class="font-display text-3xl font-extrabold">Proyectos</h1>
      <p class="mt-2 text-[14.5px] text-[var(--text-soft)]">
        Selección de proyectos personales, freelance y de juegos. Filtra por área.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" id="filter-row" data-reveal>
      {projectCategories.map((c, i) => (
        <button
          data-filter={c.id}
          aria-pressed={i === 0 ? "true" : "false"}
          class="rounded-full border border-[var(--border)] px-4 py-1.5 text-[13px] font-bold text-[var(--text-soft)] transition-colors aria-[pressed=true]:border-[var(--accent)] aria-[pressed=true]:bg-[var(--accent)] aria-[pressed=true]:text-[var(--accent-on)]"
        >
          {c.label}
        </button>
      ))}
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
      {projects.map((p, i) => (
        <div data-reveal style={`transition-delay:${(i % 6) * 70}ms`}>
          <ProjectCard project={p} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<script src="/scripts/project-filters.js" is:inline></script>
