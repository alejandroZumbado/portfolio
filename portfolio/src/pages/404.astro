---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada" description="Esta página no existe.">
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="font-display text-6xl font-extrabold text-[var(--accent)]">404</p>
    <h1 class="mt-3 font-display text-2xl font-bold">No encontré esta página</h1>
    <p class="mt-2 text-[14.5px] text-[var(--text-soft)]">
      El enlace puede estar roto o la página se movió.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-[var(--accent)] px-5 py-2.5 text-[14px] font-bold text-[var(--accent-on)] transition hover:brightness-110">
        Volver al inicio
      </a>
      <a href="/proyectos" class="rounded-full border border-[var(--border)] px-5 py-2.5 text-[14px] font-bold transition hover:border-[var(--accent)]">
        Ver proyectos
      </a>
    </div>
  </section>
</Layout>
