---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { skillGroups } from "../data/site";
---

<Layout title="Habilidades" description="Tecnologías con las que trabaja Alejandro Zumbado.">
  <section class="mx-auto max-w-5xl px-6 py-14">
    <PageHeader eyebrow="03 · Stack" title="Habilidades" subtitle="Tecnologías con las que trabajo, agrupadas por área." />

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(skillGroups).map(([title, items], i) => (
        <div
          class="h-full rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5"
          data-spotlight
          data-reveal
          style={`transition-delay:${i * 70}ms`}
        >
          <div class="flex items-center justify-between">
            <h2 class="font-display text-[14px] font-bold text-[var(--accent)]">{title}</h2>
            <!-- How many tools in this group -->
            <span class="rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[11px] font-bold text-[var(--accent)]">{items.length}</span>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {items.map((it) => (
              <span class="rounded-full border border-[var(--border)] bg-[var(--surface-hover)] px-2.5 py-1 text-[12px] transition hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)]">
                {it}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
