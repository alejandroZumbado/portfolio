---
import Layout from "../layouts/Layout.astro";
import { skillGroups } from "../data/site";
---

<Layout title="Habilidades" description="Tecnologías con las que trabaja Alejandro Zumbado.">
  <section class="mx-auto max-w-5xl px-6 py-14">
    <div data-reveal>
      <h1 class="font-display text-3xl font-extrabold">Habilidades</h1>
      <p class="mt-2 text-[14.5px] text-[var(--text-soft)]">Tecnologías con las que trabajo, agrupadas por área.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(skillGroups).map(([title, items], i) => (
        <div
          class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5"
          data-reveal
          style={`transition-delay:${i * 70}ms`}
        >
          <h3 class="font-display text-[14px] font-bold text-[var(--accent)]">{title}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {items.map((it) => (
              <span class="rounded-full border border-[var(--border)] bg-[var(--surface-hover)] px-2.5 py-1 text-[12px]">
                {it}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
