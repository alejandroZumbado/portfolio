---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Timeline from "../components/Timeline.astro";
import { experience } from "../data/site";
---

<Layout title="Experiencia" description="Trayectoria profesional y educación de Alejandro Zumbado.">
  <section class="mx-auto max-w-3xl px-6 py-14">
    <PageHeader eyebrow="02 · Trayectoria" title="Experiencia" subtitle="Trayectoria profesional y educación." />
    <div class="mt-10">
      <Timeline entries={experience} />
    </div>
  </section>
</Layout>
