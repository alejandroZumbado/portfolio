---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/site";

const items = [
  { icon: "✉️", label: "Correo", value: profile.email, href: `mailto:${profile.email}` },
  { icon: "📞", label: "Teléfono", value: profile.phone, href: `tel:${profile.phone.replace(/\s/g, "")}` },
  { icon: "💻", label: "GitHub", value: "alejandroZumbado", href: profile.github },
  { icon: "📍", label: "Ubicación", value: profile.location, href: null },
];
---

<Layout title="Contacto" description="Contacta a Alejandro Zumbado.">
  <section class="mx-auto max-w-3xl px-6 py-14">
    <div data-reveal>
      <h1 class="font-display text-3xl font-extrabold">Contacto</h1>
      <p class="mt-2 text-[14.5px] text-[var(--text-soft)]">La forma más rápida de contactarme.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {items.map((it, i) => {
        const Tag = it.href ? "a" : "div";
        return (
          <Tag
            href={it.href ?? undefined}
            target={it.href?.startsWith("http") ? "_blank" : undefined}
            rel={it.href === profile.github ? "me noopener" : it.href?.startsWith("http") ? "noopener" : undefined}
            class="flex items-center gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-all hover:-translate-y-0.5 hover:border-[var(--accent)]"
            data-reveal
            style={`transition-delay:${i * 70}ms`}
          >
            <span class="text-2xl">{it.icon}</span>
            <span>
              <span class="block text-[12px] text-[var(--text-soft)]">{it.label}</span>
              <span class="block font-display text-[14.5px] font-bold">{it.value}</span>
            </span>
          </Tag>
        );
      })}
    </div>
  </section>
</Layout>
