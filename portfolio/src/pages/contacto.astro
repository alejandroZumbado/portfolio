---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../data/icons";
import { profile } from "../data/site";

// Email is not listed here: it has its own block with copy button above
const items: { icon: IconName; label: string; value: string; href: string | null }[] = [
  { icon: "phone", label: "Teléfono", value: profile.phone, href: `tel:${profile.phone.replace(/\s/g, "")}` },
  { icon: "github", label: "GitHub", value: "alejandroZumbado", href: profile.github },
  { icon: "linkedin", label: "LinkedIn", value: "alejandro-zumbado", href: profile.linkedin },
  { icon: "pin", label: "Ubicación", value: profile.location, href: null },
];
---

<Layout title="Contacto" description="Contacta a Alejandro Zumbado.">
  <section class="mx-auto max-w-3xl px-6 py-14">
    <PageHeader eyebrow="05 · Hablemos" title="Contacto" subtitle="La forma más rápida de contactarme." />

    <!-- Primary action: email, with one-click copy (public/scripts/copy-email.js) -->
    <div class="relative mt-8 overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-7" data-reveal>
      <div class="aurora opacity-60" aria-hidden="true"></div>
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-[12px] font-bold uppercase tracking-wide text-[var(--text-soft)]">Escríbeme</p>
          <p class="break-all font-display text-xl font-bold sm:text-2xl">{profile.email}</p>
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            id="copy-email"
            data-email={profile.email}
            class="rounded-full border border-[var(--border)] bg-[var(--bg)]/60 px-4 py-2 text-[13px] font-bold transition hover:border-[var(--accent)] active:scale-95"
          >
            Copiar
          </button>
          <a href={`mailto:${profile.email}`} data-magnetic class="btn-shine rounded-full bg-[var(--accent)] px-4 py-2 text-[13px] font-bold text-[var(--accent-on)] transition hover:brightness-110">
            Enviar correo
          </a>
        </div>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {items.map((it, i) => {
        const Tag = it.href ? "a" : "div";
        return (
          <Tag
            href={it.href ?? undefined}
            target={it.href?.startsWith("http") ? "_blank" : undefined}
            rel={it.href === profile.github || it.href === profile.linkedin ? "me noopener" : it.href?.startsWith("http") ? "noopener" : undefined}
            class="group flex items-center gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5"
            data-spotlight
            data-reveal
            style={`transition-delay:${i * 70}ms`}
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--accent-soft)] text-[var(--accent)] transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110"><Icon name={it.icon} size={20} /></span>
            <span>
              <span class="block text-[12px] text-[var(--text-soft)]">{it.label}</span>
              <span class="block break-all font-display text-[14.5px] font-bold">{it.value}</span>
            </span>
          </Tag>
        );
      })}
    </div>
  </section>
  <div id="toast" class="toast rounded-full bg-[var(--text)] px-4 py-2 text-[13px] font-bold text-[var(--bg)] shadow-lg" role="status" aria-live="polite"></div>
</Layout>

<script src="/scripts/copy-email.js" is:inline></script>
