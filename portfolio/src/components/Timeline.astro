---
import type { TimelineEntry } from "../data/site";

interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;
---

<div class="flex flex-col">
  {entries.map((e, i) => (
    <div
      class="group relative border-l-2 border-[var(--border)] pb-8 pl-7 transition-colors last:border-transparent last:pb-0 hover:border-[var(--accent)]"
      data-reveal
      style={`transition-delay:${Math.min(i, 5) * 60}ms`}
    >
      {/* Ongoing roles get a pulsing dot (.dot-live in global.css) */}
      <span
        class:list={[
          "absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-[var(--accent)] ring-4 ring-[var(--bg)] transition-transform group-hover:scale-125",
          e.dates.includes("Actualidad") && "dot-live",
        ]}
      ></span>
      <div class="flex flex-wrap items-center gap-2 text-[12px] font-bold text-[var(--text-soft)]">
        {e.dates}
        {e.dates.includes("Actualidad") && (
          <span class="rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[10.5px] uppercase tracking-wide text-[var(--accent)]">Actual</span>
        )}
      </div>
      <h2 class="mt-0.5 font-display text-[16px] font-bold">
        {e.role}
        {e.company && <span class="text-[var(--accent)]"> — {e.company}</span>}
      </h2>
      {e.sub && <p class="text-[13px] text-[var(--text-soft)]">{e.sub}</p>}
      {e.bullets.length > 0 && (
        <ul class="mt-2 list-disc space-y-1 pl-4 text-[13.5px] text-[var(--text)]">
          {e.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </div>
  ))}
</div>
