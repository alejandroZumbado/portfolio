---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/experiencia", label: "Experiencia" },
  { href: "/habilidades", label: "Habilidades" },
  { href: "/cv", label: "CVs" },
  { href: "/contacto", label: "Contacto" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3.5">
    <a href="/" class="font-display text-[15px] font-bold tracking-tight">
      Alejandro Zumbado
    </a>

    <nav class="hidden items-center gap-1 sm:flex">
      {links.map((l) => {
        const active = (l.href === "/" ? path === "/" : path.startsWith(l.href));
        return (
          <a
            href={l.href}
            class:list={[
              "rounded-full px-3.5 py-1.5 text-[13.5px] font-semibold transition-colors",
              active
                ? "bg-[var(--accent-soft)] text-[var(--accent)]"
                : "text-[var(--text-soft)] hover:bg-[var(--surface-hover)] hover:text-[var(--text)]",
            ]}
          >
            {l.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="grid h-9 w-9 place-items-center rounded-full border border-[var(--border)] bg-[var(--surface)] text-[15px] transition-transform hover:-translate-y-0.5"
      >
        <span id="theme-icon">🌙</span>
      </button>
      <a
        href="/cv"
        data-magnetic
        class="hidden rounded-full bg-[var(--accent)] px-4 py-1.5 text-[13.5px] font-bold text-[var(--accent-on)] transition hover:brightness-110 sm:inline-block"
      >
        Descargar CV
      </a>
    </div>
  </div>

  <nav class="flex gap-1 overflow-x-auto border-t border-[var(--border)] px-4 py-2 sm:hidden">
    {links.map((l) => (
      <a
        href={l.href}
        class="whitespace-nowrap rounded-full px-3 py-1 text-[13px] font-semibold text-[var(--text-soft)] aria-[current]:bg-[var(--accent-soft)] aria-[current]:text-[var(--accent)]"
        aria-current={path === l.href ? "page" : undefined}
      >
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script src="/scripts/theme-toggle.js" is:inline></script>
<script src="/scripts/magnetic.js" is:inline></script>
