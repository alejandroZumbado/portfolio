---
import Icon from "./Icon.astro";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/experiencia", label: "Experiencia" },
  { href: "/habilidades", label: "Habilidades" },
  { href: "/cv", label: "CVs" },
  { href: "/contacto", label: "Contacto" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// One rule for desktop + mobile nav: "/" only matches exactly, others by prefix
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!-- transition:animate="none": header stays put while <main> animates on page change -->
<header
  class="site-header sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3.5">
    <a href="/" class="flex items-center gap-2.5 font-display text-[15px] font-bold tracking-tight">
      <!-- Monogram: tilts on hover (.brand-mark in global.css) -->
      <span class="brand-mark grid h-8 w-8 place-items-center rounded-xl text-[12px] font-extrabold text-white" aria-hidden="true">AZ</span>
      Alejandro Zumbado
    </a>

    <nav class="relative isolate hidden items-center gap-1 sm:flex">
      {links.map((l) => {
        const active = isActive(l.href);
        return (
          <a
            href={l.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative rounded-full px-3.5 py-1.5 text-[13.5px] font-semibold transition-colors",
              active
                ? "text-[var(--accent)]"
                : "text-[var(--text-soft)] hover:bg-[var(--surface-hover)] hover:text-[var(--text)]",
            ]}
          >
            {/* Pill slides to the new link on navigation (view-transition-name in global.css) */}
            {active && <span class="nav-pill absolute inset-0 -z-10 rounded-full bg-[var(--accent-soft)]" aria-hidden="true"></span>}
            {l.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="grid h-9 w-9 place-items-center rounded-full border border-[var(--border)] bg-[var(--surface)] text-[15px] transition hover:-translate-y-0.5 hover:border-[var(--accent)]"
      >
        <!-- Both icons rendered; .theme-icon-* rules in global.css show the right one -->
        <span id="theme-icon" class="inline-grid">
          <Icon name="moon" class="theme-icon-moon text-[var(--text-soft)]" />
          <Icon name="sun" class="theme-icon-sun text-[var(--accent)]" />
        </span>
      </button>
      <a
        href="/cv"
        data-magnetic
        class="btn-shine hidden rounded-full bg-[var(--accent)] px-4 py-1.5 text-[13.5px] font-bold text-[var(--accent-on)] transition hover:brightness-110 sm:inline-block"
      >
        Descargar CV
      </a>
      <!-- Phones: compact CV button (the full one is hidden below sm) -->
      <a
        href="/cv"
        class="rounded-full bg-[var(--accent)] px-3 py-1.5 text-[12.5px] font-bold text-[var(--accent-on)] sm:hidden"
      >
        CV
      </a>
    </div>
  </div>

  <nav class="nav-scroll relative isolate flex gap-1 overflow-x-auto border-t border-[var(--border)] px-4 py-2 sm:hidden">
    {links.map((l) => {
      const active = isActive(l.href);
      return (
        <a
          href={l.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "relative whitespace-nowrap rounded-full px-3 py-1 text-[13px] font-semibold",
            active ? "text-[var(--accent)]" : "text-[var(--text-soft)]",
          ]}
        >
          {active && <span class="nav-pill-m absolute inset-0 -z-10 rounded-full bg-[var(--accent-soft)]" aria-hidden="true"></span>}
          {l.label}
        </a>
      );
    })}
  </nav>
</header>

<script src="/scripts/theme-toggle.js" is:inline></script>
<script src="/scripts/magnetic.js" is:inline></script>
<script src="/scripts/nav-active.js" is:inline></script>
