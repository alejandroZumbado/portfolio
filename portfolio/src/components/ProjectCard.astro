---
import type { Project } from "../data/site";

interface Props {
  project: Project;
  // Heading level depends on the page: h3 under a section h2 (home), h2 on /proyectos
  headingLevel?: "h2" | "h3";
}
const { project, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article
  class="group flex h-full flex-col gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5"
  data-spotlight
  data-categories={project.categories.join(",")}
>
  <!-- Decorative thumbnail; emoji scales/tilts on card hover (global.css .thumb) -->
  <div class="thumb grid h-28 place-items-center overflow-hidden rounded-xl border border-[var(--border)] text-5xl" aria-hidden="true">
    <span class="thumb-emoji drop-shadow-md">{project.emoji}</span>
  </div>
  <Heading class="font-display text-[16px] font-bold transition-colors group-hover:text-[var(--accent)]">{project.name}</Heading>
  <p class="text-[13.5px] leading-relaxed text-[var(--text-soft)]">{project.description}</p>
  <div class="flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <span class="rounded-md border border-[var(--border)] px-2 py-0.5 text-[11px] font-bold text-[var(--text-soft)]">
        {t}
      </span>
    ))}
  </div>
  {project.levels && project.levels.length > 0 && (
    <div class="flex flex-wrap items-center gap-1.5 pt-1">
      <span class="text-[11px] font-bold uppercase tracking-wide text-[var(--text-soft)]">Niveles</span>
      {project.levels.map((lvl) => (
        <a
          href={lvl.href}
          target="_blank"
          rel="noopener"
          class="grid h-6 w-6 place-items-center rounded-full border border-[var(--border)] text-[11px] font-bold text-[var(--text-soft)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          {lvl.label}
        </a>
      ))}
    </div>
  )}
  {(project.demo || project.repo) && (
    <div class="mt-auto flex gap-4 pt-1">
      {project.demo && (
        <a href={project.demo} target="_blank" rel="noopener" class="link-arrow text-[12.5px] font-bold text-[var(--accent)]">
          Demo <span class="arr" aria-hidden="true">→</span>
        </a>
      )}
      {project.repo && (
        <a href={project.repo} target="_blank" rel="noopener" class="link-arrow text-[12.5px] font-bold text-[var(--accent)]">
          Código <span class="arr" aria-hidden="true">→</span>
        </a>
      )}
    </div>
  )}
  {!project.demo && !project.repo && project.status && (
    <span class="mt-auto w-fit rounded-md bg-[var(--accent-soft)] px-2.5 py-1 text-[11.5px] font-bold text-[var(--accent)]">
      {project.status}
    </span>
  )}
</article>
